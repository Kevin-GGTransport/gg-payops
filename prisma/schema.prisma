generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["common", "ops", "pay"]
}

model User {
  id            Int       @id @default(autoincrement())
  email         String
  employeeNo    String?   @map("employee_no")
  displayName   String    @map("display_name")
  passwordHash  String    @map("password_hash")
  phone         String?
  locale        String    @default("zh-CN")
  isActive      Boolean   @default(true) @map("is_active")
  mfaEnabled    Boolean   @default(false) @map("mfa_enabled")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
  @@schema("common")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("common")
}

enum DriverType {
  DRIVER
  OWNER

  @@schema("ops")
}

enum LocationType {
  BASE
  AMAZON
  OTHER

  @@schema("ops")
}

enum OperationType {
  DEL
  EMPTY
  BOBTAIL
  LIVE

  @@schema("ops")
}

enum StatementStatus {
  DRAFT
  SUBMITTED
  PAID

  @@schema("pay")
}

model Driver {
  id               Int          @id @default(autoincrement())
  driverCode       String       @map("driver_code") @db.VarChar(32)
  fullName         String       @map("full_name") @db.VarChar(120)
  driverType       DriverType   @default(DRIVER) @map("driver_type")
  phone            String?      @db.VarChar(32)
  email            String?      @db.VarChar(255)
  licenseNo        String?      @map("license_no") @db.VarChar(64)
  licenseClass     String?      @map("license_class") @db.VarChar(32)
  licenseExpiresOn DateTime?    @map("license_expires_on") @db.Date
  hireDate         DateTime?    @map("hire_date") @db.Date
  terminationDate  DateTime?    @map("termination_date") @db.Date
  linkedUserId     Int?         @unique @map("linked_user_id")
  status           RecordStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([driverCode], map: "uq_drivers_code")
  @@index([driverType, status], map: "idx_drivers_type_status")
  @@map("drivers")
  @@schema("ops")
}

model Location {
  id               Int          @id @default(autoincrement())
  code             String       @db.VarChar(16)
  name             String       @db.VarChar(120)
  locationType     LocationType @default(AMAZON) @map("location_type")
  addressLine      String?      @map("address_line") @db.VarChar(255)
  city             String?      @db.VarChar(80)
  stateCode        String?      @map("state_code") @db.Char(2)
  postalCode       String?      @map("postal_code") @db.VarChar(16)
  countryCode      String       @default("US") @map("country_code") @db.Char(2)
  latitude         Decimal?     @db.Decimal(9, 6)
  longitude        Decimal?     @map("longitude") @db.Decimal(9, 6)
  isBase           Boolean      @default(false) @map("is_base")
  standardPayAmount Decimal     @default(0) @map("standard_pay_amount") @db.Decimal(12, 2)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([code], map: "uq_locations_code")
  @@index([locationType, status, code], map: "idx_locations_type")
  @@map("locations")
  @@schema("ops")
}

/// Vehicle profile; ids are bigint identity in the actual DDL (raw-SQL access)
model Truck {
  id           BigInt       @id @default(autoincrement()) @db.BigInt
  truckCode    String       @map("truck_code") @db.VarChar(32)
  plateNo      String?      @map("plate_no") @db.VarChar(32)
  truckType    String?      @map("truck_type") @db.VarChar(64)
  capacityNote String?      @map("capacity_note") @db.VarChar(120)
  status       RecordStatus @default(ACTIVE)
  notes        String?
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([truckCode], map: "uq_trucks_code")
  @@index([status, truckCode], map: "idx_trucks_status")
  @@map("trucks")
  @@schema("ops")
}

/// Ownership history; owner_driver_id NULL = company-owned. One open row
/// (valid_to NULL) per truck enforced by a partial unique index in the DDL.
model TruckOwnership {
  id           BigInt    @id @default(autoincrement()) @db.BigInt
  truckId      BigInt    @map("truck_id") @db.BigInt
  ownerDriverId BigInt?  @map("owner_driver_id") @db.BigInt
  validFrom    DateTime  @map("valid_from") @db.Date
  validTo      DateTime? @map("valid_to") @db.Date
  note         String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([truckId, validFrom(sort: Desc)], map: "idx_truck_ownerships_truck")
  @@map("truck_ownerships")
  @@schema("ops")
}

/// Manual odometer readings; the latest one is the truck's current 表显里程
model TruckOdometerReading {
  id          BigInt   @id @default(autoincrement()) @db.BigInt
  truckId     BigInt   @map("truck_id") @db.BigInt
  readingDate DateTime @map("reading_date") @db.Date
  odometer    Decimal  @db.Decimal(10, 1)
  note        String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([truckId, readingDate(sort: Desc)], map: "idx_truck_odometer_truck_date")
  @@map("truck_odometer_readings")
  @@schema("ops")
}

model Trip {
  id             Int           @id @default(autoincrement())
  driverId       Int           @map("driver_id")
  tripDate       DateTime      @default(dbgenerated("CURRENT_DATE")) @map("trip_date") @db.Date
  operation      OperationType
  loadNo         String        @map("load_no") @db.VarChar(64)
  fromLocationId Int?          @map("from_location_id")
  toLocationId   Int?          @map("to_location_id")
  miles          Decimal       @default(0) @db.Decimal(10, 2)
  payAmount      Decimal       @default(0) @map("pay_amount") @db.Decimal(12, 2)
  notes          String?
  /// Submit-time driver name snapshot (driver_id stays for payroll joins)
  driverName     String?       @map("driver_name") @db.VarChar(120)
  /// Submit-time full truck snapshot {truck_id, truck_code, plate_no, truck_type, capacity_note}
  truckSnapshot  Json?         @map("truck_snapshot")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([driverId, tripDate], map: "idx_trips_driver_date")
  @@index([tripDate], map: "idx_trips_date")
  @@map("trips")
  @@schema("pay")
}

/// Wage-rule version keyed by effective_from (unique); pricing inputs come
/// from the paper spec and are edited on the /dashboard/wage-rules page.
/// raw-SQL access only (bigint identity ids, no Prisma-client writes)
model WageRuleVersion {
  id                BigInt   @id @default(autoincrement()) @db.BigInt
  name              String   @db.VarChar(120)
  effectiveFrom     DateTime @map("effective_from") @db.Date
  ownerMultiplier   Decimal  @default(2.00) @map("owner_multiplier") @db.Decimal(5, 2)
  bobtailMultiplier Decimal  @default(0.50) @map("bobtail_multiplier") @db.Decimal(5, 2)
  overageIncrement  Decimal  @default(30.00) @map("overage_increment") @db.Decimal(12, 2)
  status            String   @default("ACTIVE") @db.VarChar(16)
  notes             String?  @db.VarChar(255)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([effectiveFrom], map: "uq_wage_rule_effective")
  @@map("wage_rule_versions")
  @@schema("pay")
}

/// Driver-price mileage band; legs at/above miles_from bill amount
model WageRuleTier {
  id        BigInt  @id @default(autoincrement()) @db.BigInt
  versionId BigInt  @map("version_id") @db.BigInt
  milesFrom Int     @map("miles_from")
  amount    Decimal @db.Decimal(12, 2)

  @@unique([versionId, milesFrom], map: "uq_wage_tier_version_miles")
  @@map("wage_rule_tiers")
  @@schema("pay")
}

/// Fixed-price postal pair (either direction bills one_way_amount)
model WageRuleSpecialRoute {
  id           BigInt  @id @default(autoincrement()) @db.BigInt
  versionId    BigInt  @map("version_id") @db.BigInt
  fromPostal   String  @map("from_postal") @db.VarChar(10)
  toPostal     String  @map("to_postal") @db.VarChar(10)
  oneWayAmount Decimal @map("one_way_amount") @db.Decimal(12, 2)
  note         String? @db.VarChar(255)

  @@index([versionId], map: "idx_wage_special_routes_version")
  @@map("wage_rule_special_routes")
  @@schema("pay")
}
