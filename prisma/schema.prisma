generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["common", "ops", "pay"]
}

model User {
  id            Int       @id @default(autoincrement())
  email         String
  employeeNo    String?   @map("employee_no")
  displayName   String    @map("display_name")
  passwordHash  String    @map("password_hash")
  phone         String?
  locale        String    @default("zh-CN")
  isActive      Boolean   @default(true) @map("is_active")
  mfaEnabled    Boolean   @default(false) @map("mfa_enabled")
  lastLoginAt   DateTime? @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("users")
  @@schema("common")
}

enum RecordStatus {
  ACTIVE
  INACTIVE
  ARCHIVED

  @@schema("common")
}

enum DriverType {
  DRIVER
  OWNER

  @@schema("ops")
}

enum LocationType {
  BASE
  AMAZON
  OTHER

  @@schema("ops")
}

enum OperationType {
  DEL
  EMPTY
  BOBTAIL
  LIVE

  @@schema("ops")
}

enum StatementStatus {
  DRAFT
  SUBMITTED
  PAID

  @@schema("pay")
}

model Driver {
  id               Int          @id @default(autoincrement())
  driverCode       String       @map("driver_code") @db.VarChar(32)
  fullName         String       @map("full_name") @db.VarChar(120)
  driverType       DriverType   @default(DRIVER) @map("driver_type")
  phone            String?      @db.VarChar(32)
  email            String?      @db.VarChar(255)
  licenseNo        String?      @map("license_no") @db.VarChar(64)
  licenseClass     String?      @map("license_class") @db.VarChar(32)
  licenseExpiresOn DateTime?    @map("license_expires_on") @db.Date
  hireDate         DateTime?    @map("hire_date") @db.Date
  terminationDate  DateTime?    @map("termination_date") @db.Date
  linkedUserId     Int?         @unique @map("linked_user_id")
  status           RecordStatus @default(ACTIVE)
  notes            String?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([driverCode], map: "uq_drivers_code")
  @@index([driverType, status], map: "idx_drivers_type_status")
  @@map("drivers")
  @@schema("ops")
}

model Location {
  id               Int          @id @default(autoincrement())
  code             String       @db.VarChar(16)
  name             String       @db.VarChar(120)
  locationType     LocationType @default(AMAZON) @map("location_type")
  addressLine      String?      @map("address_line") @db.VarChar(255)
  city             String?      @db.VarChar(80)
  stateCode        String?      @map("state_code") @db.Char(2)
  postalCode       String?      @map("postal_code") @db.VarChar(16)
  countryCode      String       @default("US") @map("country_code") @db.Char(2)
  latitude         Decimal?     @db.Decimal(9, 6)
  longitude        Decimal?     @map("longitude") @db.Decimal(9, 6)
  isBase           Boolean      @default(false) @map("is_base")
  standardPayAmount Decimal     @default(0) @map("standard_pay_amount") @db.Decimal(12, 2)
  status           RecordStatus @default(ACTIVE)
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([code], map: "uq_locations_code")
  @@index([locationType, status, code], map: "idx_locations_type")
  @@map("locations")
  @@schema("ops")
}

model Trip {
  id             Int           @id @default(autoincrement())
  driverId       Int           @map("driver_id")
  tripDate       DateTime      @default(dbgenerated("CURRENT_DATE")) @map("trip_date") @db.Date
  operation      OperationType
  loadNo         String        @map("load_no") @db.VarChar(64)
  fromLocationId Int?          @map("from_location_id")
  toLocationId   Int?          @map("to_location_id")
  miles          Decimal       @default(0) @db.Decimal(10, 2)
  payAmount      Decimal       @default(0) @map("pay_amount") @db.Decimal(12, 2)
  notes          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([driverId, tripDate], map: "idx_trips_driver_date")
  @@map("trips")
  @@schema("pay")
}
